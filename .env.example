# =============================================================================
# PLATAFORMA EDUCACIONAL - Cursando Flow
# Copie para .env e ajuste conforme ambiente
# =============================================================================

# --- Autenticacao ---
JWT_SECRET=local-development-secret

# --- Portas (cada servico) ---
AUTH_PORT=4001
ADMIN_PORT=4002
CATALOG_PORT=4003
PROGRESS_PORT=4004
FILES_PORT=4005
GATEWAY_PORT=4000
STOREFRONT_PORT=3000
CLASSROOM_PORT=3004

# --- URLs dos backends (usado pelo Gateway para proxy) ---
AUTH_URL=http://localhost:4001
ADMIN_URL=http://localhost:4002
CATALOG_URL=http://localhost:4003
PROGRESS_URL=http://localhost:4004
FILES_URL=http://localhost:4005

# --- URLs do frontend (usado pelo Storefront e Classroom) ---
GATEWAY_URL=http://localhost:4000
CLASSROOM_HOST=localhost

# --- Bancos de Dados (SQLite) ---
AUTH_DATABASE=storage/auth/auth.sqlite
ADMIN_DATABASE=storage/admin/admin.sqlite
CATALOG_DATABASE=storage/catalog/catalog.sqlite
PROGRESS_DATABASE=storage/progress/progress.sqlite
FILES_DATABASE=storage/files/files.sqlite

# --- Armazenamento de Arquivos ---
FILE_STORAGE=storage/files
